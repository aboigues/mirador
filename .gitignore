.venv/
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.coverage
htmlcov/
dist/
build/
*.egg-info/
.env
.env.local

# Secrets — ne jamais commiter
*.pem
*.key
mirador-depots.json
.env*
# Le glob final couvre les dérivées (.bak, .old, .save, .1…) : sans lui, une
# simple copie de sauvegarde échappe à l'ignore et devient committable.
**/.secrets.env*
!.env.example

# Copies de sauvegarde d'éditeurs/scripts — peuvent dupliquer un fichier de secrets
*.bak
*.orig

# Fichiers swap d'éditeur (jamais dans le dépôt — peuvent contenir des secrets)
*.swp
*.swo

# Fichiers de verrou / sauvegarde d'Emacs
\#*\#
.\#*

# Tout fichier .env nommé « secret(s) », avec ou sans point initial
*secret*.env*
